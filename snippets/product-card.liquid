{% comment %}
  Product card — Goûtu theme (PopCard)
  Usage: {% render 'product-card', product: product, image_style: 'rounded' %}
{% endcomment %}

{%- assign card_color   = product.metafields.custom.tint_color.value | default: '#FF6A00' -%}
{%- assign card_tint    = product.metafields.custom.tint_bg.value    | default: '#FFD7B5' -%}
{%- assign card_accent  = product.metafields.custom.tint_accent.value | default: card_color -%}
{%- assign card_punch   = product.metafields.custom.punch.value | default: product.description | strip_html | truncate: 60 -%}
{%- assign card_drop    = product.metafields.custom.drop.value | default: product.type -%}
{%- assign card_gamme   = product.collections.first.title | default: product.type -%}
{%- assign card_emoji   = product.metafields.custom.emoji.value | default: '🌿' -%}
{%- assign card_style   = image_style | default: 'rounded' -%}
{%- assign card_blob_i  = forloop.index | default: 0 | modulo: 4 -%}

<article class="g-product-card"
         data-gamme="{{ product.collections.first.handle | default: product.type | handleize }}"
         data-tint-color="{{ card_color }}"
         data-tint-bg="{{ card_tint }}"
         data-tint-accent="{{ card_accent }}"
         data-tint-hover="true">
  <a href="{{ product.url }}"
     data-tint-color="{{ card_color }}"
     data-tint-bg="{{ card_tint }}"
     data-tint-accent="{{ card_accent }}">

    <div class="g-product-card__visual g-product-card__visual--{{ card_style }}"
         style="background: {{ card_tint }};">

      <!-- Blob décoratif -->
      <div class="g-product-card__blob-bg" style="background:{{ card_color }};clip-path:polygon(40% 0%,75% 4%,100% 30%,98% 68%,78% 98%,38% 100%,8% 78%,0% 42%,12% 15%);opacity:0.85;"></div>

      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             width="600" height="800"
             loading="lazy"
             style="position:relative;z-index:1;width:80%;height:80%;object-fit:contain;">
      {%- else -%}
        <!-- Pot SVG par défaut -->
        <div style="position:relative;z-index:1;">
          <svg viewBox="0 0 80 100" style="width:100px;height:125px;" aria-hidden="true">
            <path d="M14 26 h52 v60 a4 4 0 0 1-4 4 H18 a4 4 0 0 1-4-4 z"
                  fill="{{ card_tint }}" stroke="{{ card_color }}" stroke-width="2.5" stroke-linejoin="round"/>
            <path d="M18 16 h44 v10 H18 z"
                  fill="{{ card_color }}" stroke="{{ card_color }}" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="40" cy="56" r="14" fill="var(--bg)" stroke="{{ card_color }}" stroke-width="2"/>
            <text x="40" y="60" text-anchor="middle" font-family="'Fraunces',serif" font-weight="900" font-size="9" fill="{{ card_color }}">{{ product.type | upcase | truncate: 5, '' }}</text>
          </svg>
        </div>
      {%- endif -%}

      <!-- Sticker NEW si nouveau produit -->
      {%- if product.tags contains 'nouveaute' or product.created_at > 'now' | date_minus: 60 -%}
        <div class="g-product-card__new">
          {%- render 'star-sticker', label: 'NEW', color: card_color, size: 80, rotate: -12 -%}
        </div>
      {%- endif -%}

      <!-- Drop tag (format/info) -->
      {%- if card_drop != blank -%}
        <div class="g-product-card__drop">
          <span class="g-pill" style="background:var(--ink);color:var(--bg);font-size:11px;padding:6px 12px;">
            {{ card_drop }}
          </span>
        </div>
      {%- endif -%}
    </div>

    <div class="g-product-card__meta">
      <div class="g-product-card__gamme">{{ card_emoji }} {{ card_gamme }}</div>
      <h3 class="g-product-card__name">{{ product.title }}</h3>
      {%- if card_punch != blank -%}
        <p class="g-product-card__punch">{{ card_punch }}</p>
      {%- endif -%}
      <div class="g-product-card__footer">
        <span class="g-product-card__price">
          {%- if product.price_varies -%}
            À partir de {{ product.price_min | money_without_trailing_zeros }}<span> €</span>
          {%- else -%}
            {{ product.price | money_without_trailing_zeros }}<span> €</span>
          {%- endif -%}
        </span>
        <button class="g-product-card__btn" aria-label="Voir {{ product.title }}">
          Voir →
        </button>
      </div>
    </div>
  </a>
</article>
