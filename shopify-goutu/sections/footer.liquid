<footer class="g-footer" role="contentinfo">
  <div class="g-footer__inner">
    <div class="g-footer__brand">
      <a href="{{ routes.root_url }}" class="g-footer__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: height: 40 }}" alt="{{ shop.name }}" height="40" loading="lazy">
        {%- else -%}
          {%- assign lp = section.settings.logo_text | default: 'Goûtu.' | split: '.' -%}
          {{ lp.first }}<em>.</em>
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="g-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- if section.settings.show_socials -%}
        <div class="g-footer__socials">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" aria-label="Instagram" class="g-footer__social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" aria-label="TikTok" class="g-footer__social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.09a8.28 8.28 0 0 0 4.84 1.55V7.2a4.84 4.84 0 0 1-1.07-.51z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu_column' -%}
        <div class="g-footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="g-footer__col-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul class="g-footer__links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}" class="g-footer__link">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- elsif block.type == 'text_column' -%}
        <div class="g-footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="g-footer__col-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="g-footer__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="g-footer__bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</p>
    {%- if section.settings.bottom_menu != blank -%}
      <ul class="g-footer__bottom-links">
        {%- for link in linklists[section.settings.bottom_menu].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

<style>
  .g-footer {
    background: var(--ink);
    color: var(--bg);
    border-top: var(--border);
  }
  .g-footer__inner {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--gap-x);
    padding: clamp(60px, 8vw, 100px) var(--page-x);
  }
  .g-footer__logo {
    font: 900 28px/1 var(--display);
    letter-spacing: -0.04em;
    color: var(--bg);
    text-decoration: none;
  }
  .g-footer__logo em { color: var(--accent); font-style: normal; }
  .g-footer__tagline {
    margin-top: 14px;
    font: 500 14px/1.6 var(--body);
    color: var(--ink-mute);
    max-width: 240px;
  }
  .g-footer__socials { display: flex; gap: 12px; margin-top: 20px; }
  .g-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 2px solid var(--bg);
    border-radius: 999px;
    color: var(--bg);
    transition: background .2s, color .2s;
  }
  .g-footer__social-link:hover { background: var(--accent); border-color: var(--accent); color: var(--ink); }
  .g-footer__col-title {
    font: 700 11px/1 var(--mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 16px;
  }
  .g-footer__links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .g-footer__link { color: var(--bg); text-decoration: none; font: 600 15px/1 var(--body); }
  .g-footer__link:hover { color: var(--accent); }
  .g-footer__text { font: 500 14px/1.7 var(--body); color: var(--ink-mute); }
  .g-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px var(--page-x);
    border-top: 1px solid rgba(255,255,255,.12);
    font: 600 12px/1 var(--mono);
    letter-spacing: .06em;
    color: var(--ink-mute);
  }
  .g-footer__bottom-links { list-style: none; padding: 0; margin: 0; display: flex; gap: 20px; }
  .g-footer__bottom-links a { color: var(--ink-mute); text-decoration: none; }
  .g-footer__bottom-links a:hover { color: var(--bg); }
  @media (max-width: 1024px) {
    .g-footer__inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .g-footer__inner { grid-template-columns: 1fr; }
    .g-footer__bottom { flex-direction: column; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "image_picker", "id": "logo",        "label": "Logo" },
    { "type": "text",         "id": "logo_text",   "label": "Texte logo", "default": "Goûtu." },
    { "type": "text",         "id": "tagline",     "label": "Tagline",    "default": "Soigner. Régaler. Avignon." },
    { "type": "checkbox",     "id": "show_socials","label": "Afficher les réseaux", "default": true },
    { "type": "url",          "id": "instagram",   "label": "Instagram" },
    { "type": "url",          "id": "tiktok",      "label": "TikTok" },
    { "type": "link_list",    "id": "bottom_menu", "label": "Menu bas de page" }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Colonne menu",
      "settings": [
        { "type": "text",      "id": "title", "label": "Titre" },
        { "type": "link_list", "id": "menu",  "label": "Menu" }
      ]
    },
    {
      "type": "text_column",
      "name": "Colonne texte",
      "settings": [
        { "type": "text",     "id": "title", "label": "Titre" },
        { "type": "richtext", "id": "text",  "label": "Texte" }
      ]
    }
  ]
}
{% endschema %}
