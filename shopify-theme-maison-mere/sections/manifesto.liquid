<!-- SECTION: Manifesto / Histoire — Maison Mère -->

<section class="m-manifesto">
  <!-- Cachet décoratif -->
  <div style="position:absolute;top:40px;right:40px;opacity:0.6;">
    {%- render 'cachet',
        label: section.settings.stamp_label | default: 'MAISON MÈRE',
        center: '★',
        size: 160 -%}
  </div>

  <div class="m-manifesto__inner">
    <div class="m-label">{{ section.settings.label | default: 'Notre histoire en deux mots' }}</div>
    <h2 class="m-manifesto__title">
      {{ section.settings.title | default: 'On a fondé cette maison parce qu\'on en avait <em>assez</em> de choisir entre <em>efficace</em> et <em>délicieux.</em>' }}
    </h2>
    <p class="m-manifesto__text">
      {{ section.settings.text | default: 'Tout est cuisiné dans notre atelier d\'Avignon — petits lots, beurre AOP, plantes du jardin, miels d\'apiculteurs voisins. La règle qu\'on s\'est donnée : si on n\'en mangerait pas chez nous, on ne le vend pas.' }}
    </p>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/pages/notre-histoire' }}"
         class="m-btn-ghost" style="margin-top:32px;display:inline-flex;">
        {{ section.settings.cta_label }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M7 17L17 7M7 7h10v10"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Manifesto / Histoire",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Étiquette",
      "default": "Notre histoire en deux mots"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Citation principale",
      "default": "<p>On a fondé cette maison parce qu'on en avait <em>assez</em> de choisir entre <em>efficace</em> et <em>délicieux.</em></p>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte descriptif",
      "default": "Tout est cuisiné dans notre atelier d'Avignon — petits lots, beurre AOP, plantes du jardin, miels d'apiculteurs voisins. La règle qu'on s'est donnée : si on n'en mangerait pas chez nous, on ne le vend pas."
    },
    {
      "type": "text",
      "id": "stamp_label",
      "label": "Texte du tampon décoratif",
      "default": "MAISON MÈRE"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bouton — texte",
      "default": "Lire notre histoire"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Bouton — lien"
    }
  ],
  "presets": [{ "name": "Manifesto / Histoire" }]
}
{% endschema %}

