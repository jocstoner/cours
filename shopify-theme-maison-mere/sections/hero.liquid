<!-- SECTION: Hero — Maison Mère -->
<!-- Supports 4 layouts: postcard, shelf, magazine, tampon -->

{%- assign layout = section.settings.hero_layout -%}

{%- if layout == 'postcard' or layout == blank -%}

<section class="m-hero-postcard">
  <div class="m-hero-postcard__grid">
    <div>
      <div class="m-hero-postcard__tagline">{{ section.settings.tagline | default: '★ Récolte XII · Printemps 2026' }}</div>
      <h1 class="m-hero-postcard__title">
        {{ section.settings.title | default: 'Du <em>jardin</em><br>au <em>placard</em>.' }}
      </h1>
      <p class="m-hero-postcard__desc">
        {{ section.settings.description | default: 'Miels crus, biscuits aux plantes, infusions herboristes, macérats solaires, beurres clarifiés. Une maison familiale fondée à Avignon, en 2018.' }}
      </p>
      <div class="m-hero-postcard__ctas">
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
           class="m-btn-primary">
          {{ section.settings.cta_label | default: 'Découvrir le comptoir' }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_url | default: '/pages/notre-histoire' }}"
             class="m-btn-ghost">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="m-hero-postcard__visual">
      <!-- Grande carte postale -->
      <div class="m-hero-postcard__card" style="background:var(--accent-tint);">
        <div class="m-hero-postcard__card-inner">
          {%- render 'botanical-svg', type: 'lavande', color: 'var(--accent)', width: '40%', height: '90%' -%}
        </div>
        <div style="position:absolute;top:30px;right:30px;">
          {%- render 'cachet', label: 'MAISON MÈRE', center: '★', size: 110 -%}
        </div>
        <div style="position:absolute;bottom:30px;left:30px;font-family:var(--mono);font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);">
          Pl. III · <em style="font-family:var(--display);text-transform:none;letter-spacing:0;">Lavandula angustifolia</em>
        </div>
      </div>

      <!-- Mini carte postale produit -->
      {%- if section.settings.featured_product != blank -%}
        {%- assign feat_prod = section.settings.featured_product -%}
        <div class="m-hero-postcard__mini-card" style="background:var(--cream);"
             data-tint-color="{{ feat_prod.metafields.custom.tint_color.value | default: '#c46a2e' }}"
             data-tint-bg="{{ feat_prod.metafields.custom.tint_bg.value | default: '#f0d4b8' }}"
             data-tint-hover="true">
          <div class="m-label">★ Best-seller</div>
          <h3 style="font:normal 500 24px/1.1 var(--display);margin:10px 0 0;">{{ feat_prod.title }}</h3>
          <div style="font:italic 400 14px/1.3 var(--display);color:var(--ink-mute);margin-top:4px;">
            {{ feat_prod.variants.first.title != 'Default Title' ? feat_prod.variants.first.title : '' }} · {{ feat_prod.price | money }}
          </div>
        </div>
      {%- else -%}
        <div class="m-hero-postcard__mini-card" style="background:var(--cream);">
          <div class="m-label">★ Best-seller</div>
          <h3 style="font:normal 500 24px/1.1 var(--display);margin:10px 0 0;">Miel de Thym</h3>
          <div style="font:italic 400 14px/1.3 var(--display);color:var(--ink-mute);margin-top:4px;">250 g · 18,00 €</div>
          <div style="position:absolute;right:-10px;bottom:-10px;opacity:0.45;">
            {%- render 'botanical-svg', type: 'thym', color: 'var(--accent)', width: '100px', height: '130px' -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- elsif layout == 'magazine' -%}

<section class="m-hero-magazine">
  <div class="m-hero-magazine__left">
    {%- if section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 900 }}"
           alt="{{ section.settings.hero_image.alt | escape }}"
           style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.7;"
           loading="eager">
    {%- else -%}
      <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
        {%- render 'botanical-svg', type: 'fleur', color: 'var(--accent)', width: '55%', height: '65%' -%}
      </div>
    {%- endif -%}
    <div style="position:absolute;top:60px;right:60px;opacity:0.85;">
      {%- render 'cachet', label: 'MAISON MÈRE', center: '★', size: 130 -%}
    </div>
    <div style="position:absolute;bottom:30px;left:30px;font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);">
      Numéro XII · Printemps 2026
    </div>
  </div>
  <div class="m-hero-magazine__right">
    <div class="m-label">✿ Magazine d'apothicaire</div>
    <h1 style="font:normal 500 clamp(54px,7vw,112px)/0.95 var(--display);letter-spacing:-0.025em;margin:20px 0 0;">
      {{ section.settings.title | default: 'Au <em>menu</em><br>ce printemps.' }}
    </h1>
    <p style="margin-top:28px;font:400 19px/1.65 var(--body);color:var(--ink-mute);max-width:480px;">
      {{ section.settings.description | default: 'La nouvelle récolte de miel de thym, des infusions ajustées pour les soirs frais, et notre macérat de calendula remis en pot.' }}
    </p>
    <div style="display:flex;gap:14px;margin-top:32px;">
      <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
         class="m-btn-primary">
        {{ section.settings.cta_label | default: 'Découvrir' }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

{%- elsif layout == 'tampon' -%}

<section style="padding:var(--hero-y) var(--page-x);background:var(--accent-tint);transition:background .6s;position:relative;overflow:hidden;min-height:85vh;display:flex;align-items:center;">
  <div style="position:absolute;top:8%;right:6%;opacity:0.85;">
    {%- render 'cachet', label: 'MAISON MÈRE', center: '✿', size: 260 -%}
  </div>
  <div style="position:absolute;bottom:8%;right:24%;opacity:0.7;">
    {%- render 'cachet', label: 'AVIGNON · 2026', center: '★', size: 140 -%}
  </div>
  <div style="position:absolute;bottom:-6%;left:-4%;opacity:0.35;">
    {%- render 'botanical-svg', type: 'lavande', color: 'var(--accent)', width: '300px', height: '600px' -%}
  </div>
  <div style="max-width:760px;position:relative;">
    <div class="m-label">★ Récolte XII · Printemps 2026</div>
    <h1 style="font:normal 500 clamp(60px,9vw,156px)/0.92 var(--display);letter-spacing:-0.025em;margin:24px 0 0;">
      {{ section.settings.title | default: 'Plantes <em>médicinales,</em><br>recettes <em>gourmandes.</em>' }}
    </h1>
    <p style="margin-top:28px;font:400 19px/1.65 var(--body);color:var(--ink);max-width:480px;">
      {{ section.settings.description | default: 'Une maison fondée à Avignon. Tout est cuisiné à la main, en petits lots, comme on faisait chez grand-mère.' }}
    </p>
    <div style="display:flex;gap:14px;margin-top:36px;">
      <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
         class="m-btn-primary">
        {{ section.settings.cta_label | default: 'Découvrir le comptoir' }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

{%- elsif layout == 'shelf' -%}

<section class="m-hero-shelf" style="max-width:1600px;margin:0 auto;">
  <div class="m-label">★ Bienvenue au comptoir</div>
  <h1 style="font:normal 500 clamp(60px,10vw,168px)/0.92 var(--display);letter-spacing:-0.03em;margin:24px auto 0;max-width:12ch;text-wrap:balance;">
    {{ section.settings.title | default: 'Du <em>jardin</em> au placard.' }}
  </h1>
  <p style="margin-top:24px;font:400 19px/1.6 var(--body);color:var(--ink-mute);max-width:560px;margin:24px auto 0;">
    {{ section.settings.description | default: 'Une maison de plantes médicinales pensée pour la cuisine et l\'apaisement.' }}
  </p>
  <div style="display:flex;gap:14px;margin-top:32px;justify-content:center;">
    <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
       class="m-btn-primary">
      {{ section.settings.cta_label | default: 'Découvrir le comptoir' }}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Étagère de produits -->
  <div style="margin-top:80px;">
    <div style="display:flex;justify-content:space-around;align-items:flex-end;padding:0 5%;gap:8px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'shelf_product' and block.settings.product != blank -%}
          {%- assign sp = block.settings.product -%}
          {%- assign sp_color = sp.metafields.custom.tint_color.value | default: '#c46a2e' -%}
          {%- assign sp_tint  = sp.metafields.custom.tint_bg.value    | default: '#f0d4b8' -%}
          <div style="flex:1;display:flex;align-items:flex-end;justify-content:center;transform:translateY({{ forloop.index | modulo: 2 | times: 8 }}px);">
            <a href="{{ sp.url }}"
               data-tint-color="{{ sp_color }}"
               data-tint-bg="{{ sp_tint }}"
               data-tint-hover="true"
               style="display:block;text-align:center;"
               title="{{ sp.title }}">
              <!-- Pot SVG -->
              <svg viewBox="0 0 100 130" style="width:{{ 140 | plus: forloop.index | modulo: 2 | times: 20 }}px;display:block;margin:0 auto;" aria-hidden="true">
                <rect x="20" y="0" width="60" height="14" rx="4" fill="{{ sp_color }}" opacity="0.9"/>
                <rect x="12" y="14" width="76" height="90" rx="8" fill="{{ sp_tint }}"/>
                <rect x="12" y="14" width="76" height="90" rx="8" fill="none" stroke="{{ sp_color }}" stroke-width="1.5"/>
                <ellipse cx="50" cy="59" rx="24" ry="24" fill="{{ sp_color }}" opacity="0.12"/>
                <text x="50" y="100" text-anchor="middle" font-family="'DM Serif Display',serif" font-size="9" fill="{{ sp_color }}">{{ sp.type | upcase | truncate: 6, '' }}</text>
              </svg>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <!-- Planche -->
    <div class="m-shelf-plank"></div>
    <div style="margin:4px 8% 0;height:4px;background:var(--ink);opacity:0.4;"></div>
  </div>
</section>

{%- endif -%}

<!-- Bandeau valeurs -->
<div class="m-values-band">
  {%- for block in section.blocks -%}
    {%- if block.type == 'value_item' -%}
      <div class="m-values-band__item" {{ block.shopify_attributes }}>
        <span class="m-values-band__icon">{{ block.settings.icon | default: '✿' }}</span>
        {{ block.settings.text }}
      </div>
    {%- endif -%}
  {%- endfor -%}
  {%- if section.blocks == blank or section.blocks.size == 0 -%}
    <div class="m-values-band__item"><span class="m-values-band__icon">✿</span>100% bio ou cueillette sauvage</div>
    <div class="m-values-band__item"><span class="m-values-band__icon">★</span>Fait main, en petits lots</div>
    <div class="m-values-band__item"><span class="m-values-band__icon">◐</span>Livré dans toute la France</div>
    <div class="m-values-band__item"><span class="m-values-band__icon">✎</span>Un mot manuscrit dans chaque colis</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "hero_layout",
      "label": "Mise en page du hero",
      "options": [
        { "value": "postcard", "label": "Carte postale (texte + image)" },
        { "value": "magazine", "label": "Diptyque magazine" },
        { "value": "tampon",   "label": "Tampon · pleine page" },
        { "value": "shelf",    "label": "Étagère de bocaux" }
      ],
      "default": "postcard"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Accroche (petite ligne)",
      "default": "★ Récolte XII · Printemps 2026"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Titre principal",
      "default": "<p>Du <em>jardin</em><br>au <em>placard</em>.</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Miels crus, biscuits aux plantes, infusions herboristes, macérats solaires, beurres clarifiés. Une maison familiale fondée à Avignon, en 2018."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image principale (layout magazine)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bouton principal — texte",
      "default": "Découvrir le comptoir"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Bouton principal — lien"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Bouton secondaire — texte",
      "default": "Lire l'histoire"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Bouton secondaire — lien"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Produit mis en avant (carte postale)"
    }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Valeur",
      "settings": [
        { "type": "text",    "id": "icon", "label": "Icône", "default": "✿" },
        { "type": "text",    "id": "text", "label": "Texte", "default": "100% bio" }
      ]
    },
    {
      "type": "shelf_product",
      "name": "Produit étagère",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero — Carte postale",
      "settings": { "hero_layout": "postcard" }
    }
  ]
}
{% endschema %}
