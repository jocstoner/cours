<!-- SECTION: Main Product — Maison Mère -->
<!-- Effet de tinting : la page change de couleur selon le produit -->

{%- assign tint_color = product.metafields.custom.tint_color.value | default: '#c46a2e' -%}
{%- assign tint_bg    = product.metafields.custom.tint_bg.value    | default: '#f0d4b8' -%}
{%- assign product_gamme = product.collections.first.title | default: product.type -%}

<!-- Tinting automatique à l'arrivée sur la page -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.MaisonMere && window.MaisonMere.tintEngine) {
      window.MaisonMere.tintEngine.setTint('{{ tint_color }}', '{{ tint_bg }}');
    }
  });
</script>

<!-- Fil d'Ariane -->
<nav class="m-breadcrumb" aria-label="Fil d'Ariane">
  <a href="{{ routes.root_url }}">Accueil</a>
  <span class="m-breadcrumb__sep">→</span>
  <a href="{{ routes.all_products_collection_url }}">Au comptoir</a>
  {%- if product.collections.first -%}
    <span class="m-breadcrumb__sep">→</span>
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
  {%- endif -%}
  <span class="m-breadcrumb__sep">→</span>
  <span class="m-breadcrumb__current">{{ product.title }}</span>
</nav>

<!-- Layout produit : image | infos -->
<section class="m-product-layout">

  <!-- Colonne image (sticky) -->
  <div class="m-product-sticky">
    <div class="m-product-media m-product-media--{{ section.settings.image_style }}"
         style="background: {{ tint_bg }}; box-shadow: inset 0 0 0 1px var(--rule);"
         id="product-media">

      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 800 }}"
             alt="{{ product.featured_media.alt | default: product.title | escape }}"
             width="800" height="1000"
             loading="eager"
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:20px;"
             id="product-featured-img">
      {%- else -%}
        <!-- Pot SVG par défaut si pas d'image -->
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
          <svg viewBox="0 0 100 130" style="width:55%;" aria-hidden="true">
            <rect x="20" y="0" width="60" height="14" rx="4" fill="{{ tint_color }}" opacity="0.9"/>
            <rect x="12" y="14" width="76" height="90" rx="8" fill="{{ tint_bg }}"/>
            <rect x="12" y="14" width="76" height="90" rx="8" fill="none" stroke="{{ tint_color }}" stroke-width="1.5"/>
            <ellipse cx="50" cy="59" rx="24" ry="24" fill="{{ tint_color }}" opacity="0.12"/>
            <text x="50" y="100" text-anchor="middle" font-family="'DM Serif Display',serif" font-size="9" fill="{{ tint_color }}">
              {{ product.type | upcase | truncate: 8, '' }}
            </text>
          </svg>
        </div>
      {%- endif -%}

      <!-- Cachet format/certif -->
      <div style="position:absolute;top:30px;right:30px;">
        {%- render 'cachet',
            label: '★ ' | append: product.variants.first.title | append: ' ★',
            center: '✿',
            size: 100,
            color: tint_color -%}
      </div>

      {%- if product.metafields.custom.origin != blank -%}
        <div class="m-product-media__origin">{{ product.metafields.custom.origin.value }}</div>
      {%- endif -%}
    </div>

    <!-- Vignettes galerie -->
    {%- if product.media.size > 1 -%}
      <div class="m-product-thumbs">
        {%- for media in product.media limit: 4 -%}
          <button class="m-product-thumb {% if forloop.first %}is-active{% endif %}"
                  data-media-id="{{ media.id }}"
                  onclick="this.closest('.m-product-sticky').querySelector('#product-featured-img').src='{{ media | image_url: width: 800 }}'; this.closest('.m-product-thumbs').querySelectorAll('.m-product-thumb').forEach(b => b.classList.remove('is-active')); this.classList.add('is-active');"
                  aria-label="Image {{ forloop.index }}">
            <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}"
                 width="80" height="80" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Colonne infos -->
  <div>
    <div class="m-product-gamme-tag" style="color:{{ tint_color }};">
      {{ product_gamme }}{%- unless product.has_only_default_variant %} · {{ product.variants.first.title }}{%- endunless -%}
    </div>

    <h1 class="m-product-title">{{ product.title }}</h1>

    {%- if product.metafields.custom.subtitle != blank -%}
      <div class="m-product-sub">{{ product.metafields.custom.subtitle.value }}</div>
    {%- endif -%}

    <!-- Citation tagline -->
    <div class="m-product-tagline">
      <p>
        {%- if product.metafields.custom.tagline != blank -%}
          « {{ product.metafields.custom.tagline.value }} »
        {%- else -%}
          « {{ product.description | strip_html | truncate: 100 }} »
        {%- endif -%}
      </p>
    </div>

    <p class="m-product-desc">{{ product.description }}</p>

    <!-- Propriétés / certifications -->
    {%- if product.metafields.custom.benefits != blank -%}
      <div class="m-product-props">
        {%- assign benefits = product.metafields.custom.benefits.value | split: ',' -%}
        {%- for benefit in benefits -%}
          <span class="m-product-prop" style="background:{{ tint_bg }};color:{{ tint_color }};border-color:{{ tint_color }};">
            ✓ {{ benefit | strip }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Bloc achat -->
    {%- form 'product', product, id: 'product-form' -%}
      <div class="m-buy-box">
        <div class="m-buy-box__price-row">
          <div class="m-buy-box__price" style="color:{{ tint_color }};">
            {%- if product.price_varies -%}
              À partir de {{ product.price_min | money }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </div>
          <div class="m-buy-box__shipping">★ Port offert dès 50 €</div>
        </div>

        {%- unless product.has_only_default_variant -%}
          <div style="margin-top:20px;">
            {%- for option in product.options_with_values -%}
              <label for="option-{{ option.name | handleize }}"
                     style="display:block;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px;">
                {{ option.name }}
              </label>
              <select id="option-{{ option.name | handleize }}"
                      name="options[{{ option.name | escape }}]"
                      style="width:100%;padding:12px 16px;border:1px solid var(--ink);background:transparent;font:500 15px/1 var(--display);color:var(--ink);cursor:pointer;margin-bottom:16px;">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"
                          {% if option.selected_value == value %}selected{% endif %}>
                    {{ value }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="m-buy-box__actions">
          <div class="m-qty-group m-qty-input" data-price="{{ product.price | divided_by: 100.0 }}">
            <button type="button" class="m-btn-icon" data-minus style="width:50px;height:50px;" aria-label="Diminuer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </button>
            <input type="number" name="quantity" value="1" min="1" class="m-qty-input__count"
                   aria-label="Quantité" style="background:none;border:0;width:40px;text-align:center;font-family:var(--mono);font-size:15px;">
            <button type="button" class="m-btn-icon" data-plus style="width:50px;height:50px;" aria-label="Augmenter">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </button>
          </div>

          <button type="submit"
                  class="m-btn-primary"
                  style="flex:1;height:50px;background:{{ tint_color }};box-shadow:3px 3px 0 var(--ink);"
                  data-label="Ajouter au panier"
                  {%- if product.selected_or_first_available_variant.available == false -%}disabled{%- endif -%}>
            {%- if product.selected_or_first_available_variant.available -%}
              Ajouter au panier
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            {%- else -%}
              Épuisé
            {%- endif -%}
          </button>
        </div>
      </div>
    {%- endform -%}

    {%- unless product.has_only_default_variant -%}
    <script>
      (function() {
        var variants = {{ product.variants | json }};
        var form     = document.getElementById('product-form');
        if (!form) return;
        var selects  = form.querySelectorAll('select[name^="options["]');
        var idInput  = form.querySelector('input[name="id"]');
        var priceEl  = form.querySelector('.m-buy-box__price');
        var submitBtn = form.querySelector('[type="submit"]');

        function findVariant() {
          var opts = Array.from(selects).map(function(s) { return s.value; });
          return variants.find(function(v) {
            return v.options.every(function(o, i) { return o === opts[i]; });
          });
        }

        function updateForm() {
          var v = findVariant();
          if (!v) return;
          idInput.value = v.id;
          if (priceEl) priceEl.textContent = (v.price / 100).toFixed(2).replace('.', ',') + ' €';
          if (submitBtn) {
            submitBtn.disabled = !v.available;
            if (v.available) {
              submitBtn.innerHTML = 'Ajouter au panier <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
            } else {
              submitBtn.textContent = 'Épuisé';
            }
          }
          if (v.featured_image) {
            var img = document.getElementById('product-featured-img');
            if (img) img.src = v.featured_image.src;
          }
        }

        selects.forEach(function(s) { s.addEventListener('change', updateForm); });
      })();
    </script>
    {%- endunless -%}

    <!-- Onglets descriptifs -->
    <div class="m-tabs">
      <div class="m-tabs__nav" role="tablist">
        <button class="m-tab-btn" role="tab" aria-selected="true" data-tab="histoire">histoire</button>
        <button class="m-tab-btn" role="tab" aria-selected="false" data-tab="emploi">mode d'emploi</button>
        <button class="m-tab-btn" role="tab" aria-selected="false" data-tab="compo">composition</button>
      </div>
      <div class="m-tabs__panel" role="tabpanel" data-panel="histoire">
        {%- if product.metafields.custom.histoire != blank -%}
          {{ product.metafields.custom.histoire.value }}
        {%- else -%}
          <p>{{ product.description | strip_html }} On a commencé à le faire en 2019, et c'est devenu l'un des produits préférés de la maison. La récolte est annuelle ; chaque lot a sa petite signature.</p>
        {%- endif -%}
      </div>
      <div class="m-tabs__panel" role="tabpanel" data-panel="emploi" hidden>
        {%- if product.metafields.custom.mode_emploi != blank -%}
          {{ product.metafields.custom.mode_emploi.value }}
        {%- else -%}
          <p>1 à 3 cuillères par jour, à incorporer dans une boisson tiède, sur une tartine, ou directement. Ne pas chauffer au-delà de 40°C pour préserver les actifs. Déconseillé aux enfants de moins de 12 mois.</p>
        {%- endif -%}
      </div>
      <div class="m-tabs__panel" role="tabpanel" data-panel="compo" hidden>
        {%- if product.metafields.custom.composition != blank -%}
          {{ product.metafields.custom.composition.value }}
        {%- else -%}
          <p>100 % {{ product.title | downcase }}, issu de l'agriculture biologique et de la cueillette sauvage. Sans additif, sans conservateur, sans arôme ajouté. À conserver à l'abri de la lumière et de la chaleur.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<!-- Produits complémentaires -->
{%- if product.collections.first != blank and product.collections.first.products.size > 1 -%}
  <section class="m-related-section">
    <div style="max-width:1600px;margin:0 auto;">
      <div class="m-label">✿ Sur la même étagère</div>
      <h2 style="font:normal 500 clamp(36px,4.5vw,64px)/1 var(--display);letter-spacing:-0.02em;margin:12px 0 calc(var(--section-y) * 0.5);">
        Ils vont <em>bien ensemble.</em>
      </h2>
      <div class="m-products-grid">
        {%- for related_product in product.collections.first.products limit: 4 -%}
          {%- unless related_product.id == product.id -%}
            {%- render 'product-card',
                product: related_product,
                image_style: section.settings.image_style -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Produit principal",
  "settings": [
    {
      "type": "select",
      "id": "image_style",
      "label": "Style des images",
      "options": [
        { "value": "rounded", "label": "Arrondi" },
        { "value": "square",  "label": "Carré" },
        { "value": "circle",  "label": "Médaillon" },
        { "value": "blob",    "label": "Blob" }
      ],
      "default": "rounded"
    }
  ]
}
{% endschema %}
